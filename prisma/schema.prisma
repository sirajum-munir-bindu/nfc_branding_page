datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id              BigInt           @id @default(autoincrement())
  password        String           @db.VarChar(128)
  lastLogin       DateTime?        @map("last_login") @db.Timestamptz(6)
  isSuperuser     Boolean          @default(false) @map("is_superuser")
  firstName       String           @default("") @map("first_name") @db.VarChar(150)
  lastName        String           @default("") @map("last_name") @db.VarChar(150)
  isStaff         Boolean          @default(false) @map("is_staff")
  isActive        Boolean          @default(true) @map("is_active")
  dateJoined      DateTime         @default(now()) @map("date_joined") @db.Timestamptz(6)
  username        String?          @unique @db.VarChar(150)
  email           String           @unique @db.VarChar(254)
  phone           String?          @db.VarChar(20)
  role            String           @default("CUSTOMER") @db.VarChar(20)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  customerProfile CustomerProfile?

  @@map("accounts_user")
}

model CustomerProfile {
  id          BigInt    @id @default(autoincrement())
  userId      BigInt?   @unique @map("user_id")
  user        User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String    @db.VarChar(255)
  email       String    @db.VarChar(254)
  phone       String    @db.VarChar(30)
  company     String?   @default("") @db.VarChar(255)
  designation String?   @default("") @db.VarChar(255)
  address     String?   @default("") @db.Text
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("accounts_customerprofile")
}

model SiteSetting {
  id          BigInt   @id @default(autoincrement())
  key         String   @unique @db.VarChar(100)
  value       String   @default("") @db.Text
  description String?  @default("") @db.VarChar(255)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("accounts_sitesetting")
}

model Product {
  id            BigInt      @id @default(autoincrement())
  name          String      @db.VarChar(255)
  slug          String      @unique @db.VarChar(255)
  edition       String      @default("Standard Edition") @db.VarChar(100)
  description   String?     @default("") @db.Text
  price         Decimal     @default(599.00) @db.Decimal(10, 2)
  regularPrice  Decimal?    @map("regular_price") @db.Decimal(10, 2)
  vipPrice      Decimal?    @map("vip_price") @db.Decimal(10, 2)
  discountPrice Decimal?    @map("discount_price") @db.Decimal(10, 2)
  image         String?     @db.VarChar(100)
  imageUrl      String?     @default("") @map("image_url") @db.VarChar(500)
  backImage     String?     @map("back_image") @db.VarChar(100)
  backImageUrl  String?     @default("") @map("back_image_url") @db.VarChar(500)
  stock         Int         @default(100)
  isActive      Boolean     @default(true) @map("is_active")
  colorHex      String      @default("#0f172a") @map("color_hex") @db.VarChar(50)
  finish        String      @default("Matte Brushed") @db.VarChar(100)
  badgeText     String?     @default("") @map("badge_text") @db.VarChar(100)
  features      Json?       @default("[]")
  displayOrder  Int         @default(0) @map("display_order")
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  orderItems    OrderItem[]

  @@map("products_product")
}

model CardDesign {
  id           BigInt   @id @default(autoincrement())
  name         String   @db.VarChar(100)
  editionCode  String   @unique @map("edition_code") @db.VarChar(50)
  description  String?  @default("") @db.Text
  price        Decimal  @default(599.00) @db.Decimal(10, 2)
  primaryColor String   @default("#0b0f19") @map("primary_color") @db.VarChar(50)
  accentColor  String   @default("#38bdf8") @map("accent_color") @db.VarChar(50)
  textureType  String   @default("matte-metallic") @map("texture_type") @db.VarChar(50)
  previewImage String?  @map("preview_image") @db.VarChar(100)
  features     Json?    @default("[]")
  isActive     Boolean  @default(true) @map("is_active")
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("products_carddesign")
}

model Order {
  id              BigInt      @id @default(autoincrement())
  orderNumber     String      @unique @map("order_number") @db.VarChar(50)
  customerName    String      @map("customer_name") @db.VarChar(255)
  customerEmail   String      @map("customer_email") @db.VarChar(254)
  customerPhone   String      @map("customer_phone") @db.VarChar(30)
  shippingAddress String      @map("shipping_address") @db.Text
  totalAmount     Decimal     @default(0.00) @map("total_amount") @db.Decimal(10, 2)
  status          String      @default("Pending") @db.VarChar(30)
  paymentStatus   String      @default("Pending") @map("payment_status") @db.VarChar(30)
  notes           String?     @db.Text
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  items           OrderItem[]

  @@map("orders_order")
}

model OrderItem {
  id                BigInt   @id @default(autoincrement())
  orderId           BigInt   @map("order_id")
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId         BigInt?  @map("product_id")
  product           Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName       String   @default("") @map("product_name") @db.VarChar(255)
  quantity          Int      @default(1)
  unitPrice         Decimal  @map("unit_price") @db.Decimal(10, 2)
  customizationData Json?    @default("{}") @map("customization_data")

  @@map("orders_orderitem")
}

model Testimonial {
  id           BigInt   @id @default(autoincrement())
  name         String   @db.VarChar(255)
  designation  String   @db.VarChar(255)
  company      String   @db.VarChar(255)
  avatar       String?  @db.VarChar(100)
  avatarUrl    String?  @map("avatar_url") @db.VarChar(500)
  rating       Int      @default(5)
  review       String   @db.Text
  isActive     Boolean  @default(true) @map("is_active")
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("testimonials_testimonial")
}

model FAQ {
  id           BigInt   @id @default(autoincrement())
  question     String   @db.VarChar(500)
  answer       String   @db.Text
  category     String   @default("General") @db.VarChar(100)
  isActive     Boolean  @default(true) @map("is_active")
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("faq_faq")
}

model ContactMessage {
  id        BigInt   @id @default(autoincrement())
  name      String   @db.VarChar(255)
  email     String   @db.VarChar(254)
  phone     String?  @db.VarChar(30)
  message   String   @db.Text
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("contact_contactmessage")
}
