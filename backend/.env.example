# ==========================================
# TapCard NFC Backend Production Environment
# ==========================================

# Security Settings
# Generate a secure key in Python using: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=replace-with-a-very-strong-secret-key-in-production
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,api.yourdomain.com,127.0.0.1,localhost

# Database Configuration (PostgreSQL)
DB_NAME=nfc_card_db
DB_USER=postgres
DB_PASSWORD=your_production_db_password
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=600

# CORS & CSRF Settings
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# SSL & Security (Leave True for HTTPS in production)
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# Throttling / Rate Limits
THROTTLE_ANON_RATE=60/minute
THROTTLE_USER_RATE=1000/minute

# Logging
DJANGO_LOG_LEVEL=INFO
